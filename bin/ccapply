#!/usr/bin/env bash
# ccapply <change-name> [-o|-s|-h] [-c] -- implement an OpenSpec change in its own worktree, in a
# window you can watch/steer: a new cmux workspace inside cmux, a tmux window inside tmux.
#   -o/-s/-h  force opus/sonnet/haiku (default: the account's default model)
#   -c        use cursor-agent (/opsx-apply) instead of Claude
set -euo pipefail
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/cc.sh"

usage() { echo 'usage: ccapply <change-name> [-o|-s|-h] [-c]' >&2; exit 1; }
[[ $# -ge 1 && "$1" != -* ]] || usage
change="$1"; shift

model="" cursor=0
for arg in "$@"; do
  case "$arg" in
    -o) model=opus ;;
    -s) model=sonnet ;;
    -h) model=haiku ;;
    -c) cursor=1 ;;
    *) usage ;;
  esac
done

if [[ "$cursor" == 1 ]]; then
  printf -v cmd 'cursor-agent -w %q --force %q' "$change" "/opsx-apply $change"
else
  printf -v cmd 'claude -w %q %s%q' "$change" "${model:+--model $model }" "/opsx:apply $change"
fi

cc_open_tab "$change" "$PWD" "$cmd"
# neither cmux nor tmux: Claude can open its worktree in a tmux session itself; cursor-agent runs in this terminal
if [[ "$cursor" == 1 ]]; then
  exec bash -c "$cmd" < /dev/tty
fi
exec claude -w "$change" --tmux ${model:+--model "$model"} "/opsx:apply $change"
