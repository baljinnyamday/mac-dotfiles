#!/usr/bin/env bash
# ccapply <change-name> [-o|-s|-h] [-c] -- implement an OpenSpec change in its own worktree, in a
# window you can watch/steer: a new cmux workspace inside cmux, a tmux pane elsewhere.
#   -o/-s/-h  force opus/sonnet/haiku (default: the account's default model)
#   -c        use cursor-agent (/opsx-apply) instead of Claude
set -euo pipefail

usage() { echo 'usage: ccapply <change-name> [-o|-s|-h] [-c]' >&2; exit 1; }
[[ $# -ge 1 && "$1" != -* ]] || usage
change="$1"; shift

model="" cursor=0
for arg in "$@"; do
  case "$arg" in
    -o) model=opus ;;
    -s) model=sonnet ;;
    -h) model=haiku ;;
    -c) cursor=1 ;;
    *) usage ;;
  esac
done

if [[ "$cursor" == 1 ]]; then
  printf -v cmd 'cursor-agent -w %q --force %q' "$change" "/opsx-apply $change"
else
  printf -v cmd 'claude -w %q %s%q' "$change" "${model:+--model $model }" "/opsx:apply $change"
fi

if [[ -n "${CMUX_WORKSPACE_ID:-}" ]] && command -v cmux >/dev/null; then
  # own sidebar workspace: cmux notifications, agent status and session restore work per agent
  exec cmux new-workspace --name "$change" --cwd "$PWD" --focus true --command "$cmd"
elif [[ "$cursor" == 1 ]]; then
  # cursor-agent has no --tmux flag, so wrap it in a tmux window ourselves (run from inside tmux)
  exec tmux new-window "$cmd"
fi
exec claude -w "$change" --tmux ${model:+--model "$model"} "/opsx:apply $change"
