#!/usr/bin/env bash
# cca [plan.md] [-o|-s|-h] [-c|-a] -- build a plan in a window you can watch/steer:
# a new cmux workspace inside cmux, a tmux window inside tmux, this terminal otherwise.
# The plan comes from the file argument, from stdin (`ccp "idea" | cca`), or from an fzf pick of
# ~/.claude/plans. Inside a git repo it builds in its own worktree, .claude/worktrees/<slug> on branch
# worktree-<slug> from your current HEAD, with plans/<slug>.md as its only new file; review that with
# `ccr`. Outside a git repo it builds in place, in the current folder, and there's nothing for ccr to review.
#   -o/-s/-h  force opus/sonnet/haiku (default: the account's default model)
#   -c        build with cursor-agent instead of Claude
#   -a        build with agy on the newest Gemini Flash instead of Claude
set -euo pipefail
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/cc.sh"

usage() { echo 'usage: cca [plan.md] [-o|-s|-h] [-c|-a]' >&2; exit 1; }
model="" agent=claude file=""
for arg in "$@"; do
  case "$arg" in
    -o) model=opus ;;
    -s) model=sonnet ;;
    -h) model=haiku ;;
    -c) agent=cursor ;;
    -a) agent=agy ;;
    -*) usage ;;
    *) [[ -z "$file" ]] || usage; file="$arg" ;;
  esac
done

if [[ -z "$file" && -t 0 ]]; then
  pick=$(cd "$CC_PLANS" && ls -t -- *.md | fzf --prompt='build which plan? ' --preview 'bat --color=always --style=plain {}') || exit 0
  file="$CC_PLANS/$pick"
fi
if [[ -n "$file" ]]; then
  [[ -f "$file" ]] || { echo "cca: no such plan file: $file (pass a path, pipe the plan in, or run cca with no argument to pick one)" >&2; exit 1; }
  plan=$(<"$file")
else
  plan=$(cat)
fi
[[ -n "$plan" ]] || { echo "cca: the plan is empty" >&2; exit 1; }
slug=$(cc_plan_slug "$plan")

# where to build: a fresh worktree inside a repo, the current folder outside one
if cc_repo_root >/dev/null; then
  dir=$(cc_worktree "$slug")
  slug=${dir##*/}   # the worktree's name, including any timestamp cc_worktree added
  plan_file="$dir/plans/$slug.md"
  mkdir -p "$dir/plans"
  printf '%s\n' "$plan" > "$plan_file"
  where="worktree $dir (branch worktree-$slug)"
  after="when it's done, review with: ccr $slug"
else
  dir=$PWD
  if [[ -n "$file" ]]; then
    plan_file=$(realpath "$file")
  else
    mkdir -p "$CC_PLANS"
    plan_file="$CC_PLANS/$slug-$(date +%s).md"
    printf '%s\n' "$plan" > "$plan_file"
  fi
  where="$dir in place (not a git repo, so no worktree)"
  after="there's no worktree, so ccr can't review this one; check the changes yourself"
fi

echo "cca: plan   $plan_file" >&2
echo "cca: agent  $agent${model:+ ($model)}" >&2
echo "cca: where  $where" >&2
echo "cca: $after" >&2

prompt="Implement the plan in $plan_file. Don't commit; leave your changes uncommitted for review."
case "$agent" in
  claude) printf -v cmd 'claude --permission-mode auto %s%q' "${model:+--model $model }" "$prompt" ;;
  cursor) printf -v cmd 'cursor-agent --force %q' "$prompt" ;;
  agy)
    flash=$(cc_agy_flash)
    printf -v cmd 'agy --dangerously-skip-permissions %s-i %q' "${flash:+--model $flash }" "$prompt"
    ;;
esac

cc_open_tab "$slug" "$dir" "$cmd"
# no cmux or tmux: run it in this terminal. stdin may have been the piped plan, so give the agent the keyboard back
echo "cca: running here in this terminal" >&2
cd "$dir"
exec bash -c "$cmd" < /dev/tty
