#!/usr/bin/env bash
# ccdo "task" [-o|-s|-h] [-c|-a] -- implement a small task live in a throwaway quick-<timestamp>
# worktree, no proposal doc: a new cmux workspace inside cmux, a tmux window inside tmux.
# Outside a git repo there's no worktree, so the agent works in the current folder in that new tab.
#   -o/-s/-h  force opus/sonnet/haiku (default: the account's default model)
#   -c        use cursor-agent instead of Claude
#   -a        use agy on the newest Gemini Flash instead of Claude
# Flags can go anywhere; everything else is joined into the task.
set -euo pipefail
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/cc.sh"

model="" agent=claude task=""
for arg in "$@"; do
  case "$arg" in
    -o) model=opus ;;
    -s) model=sonnet ;;
    -h) model=haiku ;;
    -c) agent=cursor ;;
    -a) agent=agy ;;
    *) task="${task:+$task }$arg" ;;
  esac
done
[[ -n "$task" ]] || { echo 'usage: ccdo "task" [-o|-s|-h] [-c|-a]' >&2; exit 1; }

name="quick-$(date +%s)"
wt_flag=""   # "-w <name> " inside a git repo, where claude and cursor-agent make their own worktree
if cc_repo_root >/dev/null; then
  printf -v wt_flag -- '-w %q ' "$name"
else
  echo "ccdo: not a git repo, so no worktree: the agent works right in $PWD" >&2
fi

case "$agent" in
  claude) printf -v cmd 'claude %s--permission-mode auto %s%q' "$wt_flag" "${model:+--model $model }" "$task" ;;
  cursor) printf -v cmd 'cursor-agent %s--force %q' "$wt_flag" "$task" ;;
  agy)
    dir=$PWD
    if [[ -n "$wt_flag" ]]; then
      dir=$(cc_worktree "$name")  # agy has no worktree flag, so make the kind `claude -w` makes
    fi
    flash=$(cc_agy_flash)
    printf -v cmd 'cd %q && agy --dangerously-skip-permissions %s-i %q' "$dir" "${flash:+--model $flash }" "$task"
    ;;
esac

cc_open_tab "$name" "$PWD" "$cmd"
# neither cmux nor tmux: Claude can open its worktree in a tmux session itself; anything else runs in this terminal
if [[ "$agent" == claude && -n "$wt_flag" ]]; then
  exec claude -w "$name" --tmux --permission-mode auto ${model:+--model "$model"} "$task"
fi
exec bash -c "$cmd" < /dev/tty
