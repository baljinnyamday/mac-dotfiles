#!/usr/bin/env bash
# wrm -- fzf-pick a git worktree, remove it and delete its local branch. Run after the PR merges,
# from outside the worktree (e.g. `wcd` to the main checkout first).
# Refuses if the worktree has uncommitted or untracked files (gitignored ones like .venv are fine),
# and keeps the branch if its commits exist nowhere else (`git branch -D <name>` to force).
set -euo pipefail

line=$(git worktree list | fzf --prompt='remove which worktree? ') || exit 0
wt_path=$(awk '{print $1}' <<< "$line")
branch=$(awk -F'[][]' '{print $2}' <<< "$line")   # empty for a detached HEAD

git worktree remove "$wt_path"
if [[ -n "$branch" ]]; then
  git branch -d "$branch"
fi
