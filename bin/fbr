#!/usr/bin/env bash
# fbr -- fuzzy-pick a local or remote git branch and check it out.
set -euo pipefail

# strip the `* ` (current) and `+ ` (checked out in another worktree) markers
branch=$(
  git branch --all | grep -v HEAD | sed 's/^[*+ ]*//;s#remotes/origin/##' | sort -u | fzf
) || exit 0
exec git checkout "$branch"
