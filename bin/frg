#!/usr/bin/env bash
# frg "<text>" -- ripgrep for text, fzf-pick a match (bat preview), open that file in cursor.
set -euo pipefail

[[ $# -ge 1 ]] || { echo 'usage: frg "<text>"' >&2; exit 1; }
file=$(
  rg --line-number --no-heading --smart-case "$1" |
    fzf -d: --nth=3.. --preview 'bat --style=numbers --color=always --highlight-line {2} {1}' |
    cut -d: -f1
) || exit 0
exec cursor "$file"
