#!/usr/bin/env bash
# ccdoh "task" [-o|-s|-h] [-c|-a] -- run a task headless in the background. Claude moves the session
# into its own worktree under .claude/worktrees/ before editing (branched from origin's default
# branch). Check on it with `claude agents` / `claude logs <id>` / `claude attach <id>`.
#   -o/-s/-h  force opus/sonnet/haiku (default: the account's default model)
#   -c        use cursor-agent -p instead of Claude (foreground, edits your current checkout)
#   -a        use agy -p on the newest Gemini Flash instead (foreground, in a new quick-<timestamp>
#             worktree branched from your HEAD, since agy skips every permission prompt)
# Flags can go anywhere; everything else is joined into the task.
set -euo pipefail
source "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../lib/cc.sh"

model="" agent=claude task=""
for arg in "$@"; do
  case "$arg" in
    -o) model=opus ;;
    -s) model=sonnet ;;
    -h) model=haiku ;;
    -c) agent=cursor ;;
    -a) agent=agy ;;
    *) task="${task:+$task }$arg" ;;
  esac
done
[[ -n "$task" ]] || { echo 'usage: ccdoh "task" [-o|-s|-h] [-c|-a]' >&2; exit 1; }

case "$agent" in
  cursor) exec cursor-agent -p --force "$task" ;;
  agy)
    wt=$(cc_worktree "quick-$(date +%s)")
    echo "ccdoh: agy is working in $wt" >&2
    flash=$(cc_agy_flash)
    cd "$wt"
    exec agy --dangerously-skip-permissions --print-timeout 30m ${flash:+--model "$flash"} -p "$task"
    ;;
esac
exec claude --bg --permission-mode auto ${model:+--model "$model"} "$task"
